+/* Termux/Android: SELinux (untrusted_app) denies hard links inside app data,
+ * so link() returns EACCES/EPERM. Publishing must fall back to an exclusive
+ * copy, which keeps the same no-replace guarantee. */
+const HARD_LINK_UNAVAILABLE = /* @__PURE__ */ new Set([
+	"EACCES",
+	"EPERM",
+	"ENOTSUP",
+	"EOPNOTSUPP",
+	"ENOSYS"
+]);
+function isHardLinkUnavailable(error) {
+	return error instanceof Error && "code" in error && HARD_LINK_UNAVAILABLE.has(error.code);
+}
